<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Statutory identifiers on the monthly payslip PDF. Base templates
    live in hr_payroll_community (no KE dependency), so the KE module
    extends them here instead of editing them. -->
    <template id="report_payslip_ke_ids"
              inherit_id="hr_payroll_community.report_payslip">
        <xpath expr="//tr[td/strong[text()='Identification No']]"
               position="after">
            <tr t-if="o.employee_id.ke_kra_pin or o.employee_id.ke_nssf_no">
                <td><strong>KRA PIN</strong></td>
                <td><span t-field="o.employee_id.ke_kra_pin"/></td>
                <td><strong>NSSF No</strong></td>
                <td><span t-field="o.employee_id.ke_nssf_no"/></td>
            </tr>
            <tr t-if="o.employee_id.ke_shif_no">
                <td><strong>SHIF No</strong></td>
                <td><span t-field="o.employee_id.ke_shif_no"/></td>
                <td/>
                <td/>
            </tr>
        </xpath>
    </template>

    <template id="report_payslipdetails_ke_ids"
              inherit_id="hr_payroll_community.report_payslipdetails">
        <xpath expr="//tr[td/strong[text()='Identification No']]"
               position="after">
            <tr t-if="o.employee_id.ke_kra_pin or o.employee_id.ke_nssf_no">
                <td><strong>KRA PIN</strong></td>
                <td><span t-field="o.employee_id.ke_kra_pin"/></td>
                <td><strong>NSSF No</strong></td>
                <td><span t-field="o.employee_id.ke_nssf_no"/></td>
            </tr>
            <tr t-if="o.employee_id.ke_shif_no">
                <td><strong>SHIF No</strong></td>
                <td><span t-field="o.employee_id.ke_shif_no"/></td>
                <td/>
                <td/>
            </tr>
        </xpath>
    </template>
</odoo>
