<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_payslips_p9_link"
              inherit_id="hr_payroll_community.portal_my_payslips"
              name="My Payslips P9 link">
        <xpath expr="//div[hasclass('o_portal_my_payslips')]" position="inside">
            <p><a href="/my/p9">P9 Tax Deduction Cards</a></p>
        </xpath>
    </template>

    <template id="portal_my_payslip_detail_p9_button"
              inherit_id="hr_payroll_community.portal_my_payslip_detail"
              name="Payslip Detail P9 button">
        <xpath expr="//a[hasclass('btn-primary')]" position="after">
            <a t-if="payslip.date_from" class="btn btn-secondary" t-attf-href="/my/p9/#{payslip.date_from.year}/pdf">Download P9 (<t t-out="payslip.date_from.year"/>)</a>
        </xpath>
    </template>

    <template id="portal_my_payslip_detail_ke_ids"
              inherit_id="hr_payroll_community.portal_my_payslip_detail"
              name="Payslip Detail KE IDs">
        <xpath expr="//div/p[3]" position="after">
            <p t-if="payslip.employee_id.ke_kra_pin or payslip.employee_id.ke_nssf_no or payslip.employee_id.ke_shif_no">
                <t t-if="payslip.employee_id.ke_kra_pin">KRA PIN: <t t-out="payslip.employee_id.ke_kra_pin"/> </t>
                <t t-if="payslip.employee_id.ke_nssf_no">| NSSF No: <t t-out="payslip.employee_id.ke_nssf_no"/> </t>
                <t t-if="payslip.employee_id.ke_shif_no">| SHIF No: <t t-out="payslip.employee_id.ke_shif_no"/></t>
            </p>
        </xpath>
    </template>

    <template id="portal_my_p9_list" name="My P9 Cards">
        <t t-call="portal.portal_layout">
            <t t-set="title">P9 Tax Deduction Cards</t>
            <div>
                <h2>P9 Tax Deduction Cards</h2>
                <t t-if="not years">
                    <p>No payslips found.</p>
                </t>
                <t t-else="">
                    <ul>
                        <li t-foreach="years" t-as="y">
                            <a t-attf-href="/my/p9/#{y}/pdf">Download P9 for <t t-out="y"/> (PDF)</a>
                        </li>
                    </ul>
                </t>
                <a class="btn btn-secondary" href="/my/payslips">Back</a>
            </div>
        </t>
    </template>
</odoo>
