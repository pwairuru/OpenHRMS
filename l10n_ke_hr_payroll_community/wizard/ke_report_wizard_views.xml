<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ke_nssf_wizard_form" model="ir.ui.view">
        <field name="name">ke.nssf.wizard.view.form</field>
        <field name="model">ke.nssf.wizard</field>
        <field name="arch" type="xml">
            <form string="NSSF Report">
                <group>
                    <field name="month"/>
                    <field name="year"/>
                </group>
                <footer>
                    <button name="action_export" string="Export XLSX"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ke_nssf_wizard" model="ir.actions.act_window">
        <field name="name">NSSF Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ke.nssf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_ke_shif_wizard_form" model="ir.ui.view">
        <field name="name">ke.shif.wizard.view.form</field>
        <field name="model">ke.shif.wizard</field>
        <field name="arch" type="xml">
            <form string="SHIF Report">
                <group>
                    <field name="month"/>
                    <field name="year"/>
                </group>
                <footer>
                    <button name="action_export" string="Export XLSX"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ke_shif_wizard" model="ir.actions.act_window">
        <field name="name">SHIF Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ke.shif.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_ke_p9_wizard_form" model="ir.ui.view">
        <field name="name">ke.p9.wizard.view.form</field>
        <field name="model">ke.p9.wizard</field>
        <field name="arch" type="xml">
            <form string="P9 Tax Deduction Card">
                <group>
                    <field name="year"/>
                    <field name="employee_id" options="{'no_create': True}"
                           help="Empty = all-employees summary. Set an employee for the detailed individual card (landscape)."/>
                </group>
                <footer>
                    <button name="action_print" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ke_p9_wizard" model="ir.actions.act_window">
        <field name="name">P9 Tax Deduction Card</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ke.p9.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <!-- Kenya statutory reports under Payroll → Reports. -->
    <menuitem id="menu_ke_nssf_wizard" name="NSSF Report"
            parent="hr_payroll_community.menu_hr_payslip_reports"
            action="action_ke_nssf_wizard"
            groups="hr_payroll_community.group_hr_payroll_community_user"
            sequence="20"/>
    <menuitem id="menu_ke_shif_wizard" name="SHIF Report"
            parent="hr_payroll_community.menu_hr_payslip_reports"
            action="action_ke_shif_wizard"
            groups="hr_payroll_community.group_hr_payroll_community_user"
            sequence="21"/>
    <menuitem id="menu_ke_p9_wizard" name="P9 Tax Deduction Card"
            parent="hr_payroll_community.menu_hr_payslip_reports"
            action="action_ke_p9_wizard"
            groups="hr_payroll_community.group_hr_payroll_community_user"
            sequence="22"/>
</odoo>
